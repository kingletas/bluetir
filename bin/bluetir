#!/usr/bin/env ruby
# frozen_string_literal: true

# Bluetir runs from its checkout, so it uses that checkout's bundle when there
# is one. Without this the installed command can only find watir if the gems
# happen to be in the ambient gem environment — true on the machine that
# developed it, false anywhere gems are installed into the project, which is
# what CI does and what any deployment-mode install does.
gemfile = File.expand_path('../Gemfile', __dir__)
if File.exist?(gemfile) && File.exist?("#{gemfile}.lock")
  ENV['BUNDLE_GEMFILE'] ||= gemfile
  require 'bundler/setup'
end

require_relative '../lib/bluetir'

exit Bluetir::CLI.new(ARGV).run
